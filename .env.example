POSTGRES_PASSWORD=replace-with-a-long-random-password
LISTSLISTS_SECRET_KEY=replace-with-at-least-32-random-bytes
LISTSLISTS_PUBLIC_BASE_URL=https://lists.example.com
LISTSLISTS_SESSION_HTTPS_ONLY=true
# local, proxy, or both
LISTSLISTS_AUTH_MODE=local
# Required before proxy headers are trusted, e.g. Podman network or Authelia proxy subnet:
LISTSLISTS_TRUSTED_PROXY_CIDRS=172.20.0.0/16
LISTSLISTS_SMTP_HOST=smtp.example.com
LISTSLISTS_SMTP_PORT=587
LISTSLISTS_SMTP_USERNAME=lists@example.com
LISTSLISTS_SMTP_PASSWORD=replace-me
LISTSLISTS_MAIL_FROM=lists@example.com
# Optional one-time first-start admin input; omit to generate /secrets/initial-admin.txt
# LISTSLISTS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password
